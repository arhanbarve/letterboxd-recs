TMDB_API_KEY=your_tmdb_v3_key
DB_PATH=letterboxd.db
CORS_ORIGINS=http://localhost:5173

# Optional: also allow origins matching a pattern, so preview deployments
# (a new hostname on every push) aren't rejected by CORS. Anchor it — an
# unanchored pattern like .*\.vercel\.app lets any Vercel site call your API.
# CORS_ORIGIN_REGEX=^https://your-project(-[a-z0-9]+-[a-z0-9-]+)?\.vercel\.app$

# Optional: enriches recommendations with IMDb + Rotten Tomatoes ratings.
# free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional abuse ceilings, per client IP per hour. A refresh fans out thousands
# of TMDB calls on your key, so it is capped tighter than importing. Raise the
# import ceiling when running the E2E suite repeatedly against a local backend.
# RATE_LIMIT_IMPORTS_PER_HOUR=20
# RATE_LIMIT_REFRESHES_PER_HOUR=10

# Optional fallback only, for an export with no profile.csv — normally the
# username comes from the uploaded export itself.
# LETTERBOXD_USERNAME=
