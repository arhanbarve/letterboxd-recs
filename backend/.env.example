TMDB_API_KEY=your_tmdb_v3_key
DB_PATH=letterboxd.db
CORS_ORIGINS=http://localhost:5173

# Optional: route the Letterboxd scraper through a residential proxy.
# Needed when the backend runs on a datacenter/PaaS IP (Railway, etc.) —
# Cloudflare treats those with more suspicion than a home IP regardless
# of session freshness. Leave unset to disable.
# SCRAPER_PROXY_SERVER=http://proxy-host:port
# SCRAPER_PROXY_USERNAME=
# SCRAPER_PROXY_PASSWORD=
